# Optional defaults for the DeepSeek integration.
# WARNING: every VITE_* variable is embedded into the public JS bundle on GitHub Pages.
# Put a real key here only for local development; in production enter it in the app settings.
VITE_DEEPSEEK_API_KEY=
VITE_DEEPSEEK_MODEL=deepseek-flash
VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com
