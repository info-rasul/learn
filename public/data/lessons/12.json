{
  "id": 12,
  "title": "Continuous",
  "subtitle": "Длительные времена: am/is/are, was/were, will be + -ing",
  "theory": [
    {
      "type": "p",
      "text": "Если действие происходит прямо сейчас, используем <b>am / is / are + глагол с -ing</b>."
    },
    {
      "type": "table",
      "head": [
        "Форма",
        "Пример"
      ],
      "rows": [
        [
          "?",
          "Are you working?<br>Is he sleeping?"
        ],
        [
          "+",
          "I am working.<br>She is reading."
        ],
        [
          "−",
          "I am not working.<br>They aren't sleeping."
        ]
      ]
    },
    {
      "type": "h",
      "text": "Как добавить -ing"
    },
    {
      "type": "list",
      "items": [
        "read → reading, work → working",
        "write → writing (немая -e выпадает)",
        "sit → sitting, run → running (согласная удваивается)",
        "lie → lying"
      ]
    },
    {
      "type": "h",
      "text": "Сравни"
    },
    {
      "type": "list",
      "items": [
        "<b>I work</b> — я работаю (вообще, регулярно).",
        "<b>I am working</b> — я работаю (сейчас).",
        "<b>I am leaving tomorrow</b> — я уезжаю завтра (решённый план)."
      ]
    },
    {
      "type": "tip",
      "text": "Глаголы чувств и состояний обычно не ставятся в -ing: know, love, want, understand, like."
    },
    {
      "type": "h",
      "text": "Прошедшее и будущее"
    },
    {
      "type": "p",
      "text": "Длительное время показывает процесс в конкретный момент — не только сейчас, но и в прошлом или будущем."
    },
    {
      "type": "table",
      "head": [
        "Время",
        "Схема",
        "Пример"
      ],
      "rows": [
        [
          "Past Continuous",
          "was / were + -ing",
          "I was sleeping when you called."
        ],
        [
          "Present Continuous",
          "am / is / are + -ing",
          "I am sleeping."
        ],
        [
          "Future Continuous",
          "will be + -ing",
          "I will be sleeping at midnight."
        ]
      ]
    },
    {
      "type": "list",
      "items": [
        "<b>when</b> — когда (короткое действие прерывает длинное): I was reading when he came.",
        "<b>while</b> — пока (два процесса одновременно): I was reading while he was sleeping.",
        "Маркеры: at five o'clock yesterday, all evening, at this time tomorrow."
      ]
    }
  ],
